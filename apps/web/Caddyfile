home.achichorro.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle_path /zero/* {
		reverse_proxy zero-cache:4848
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
