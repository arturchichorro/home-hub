# Private operator-owned file; never give this write token to agents.
# Dedicated personal Grafana Cloud FREE stack, chosen EU data region.
LOKI_WRITE_URL=https://logs-prod-REPLACE.grafana.net/loki/api/v1/push
LOKI_TENANT=REPLACE
LOKI_WRITE_TOKEN=REPLACE_WITH_LOGS_WRITE_ONLY_ACCESS_POLICY_TOKEN
DOCKER_LOG_DIRECTORY=/var/lib/docker/containers
HOME_HUB_OPS_LOG_DIRECTORY=/var/log/home-hub
