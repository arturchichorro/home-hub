# Local private MCP launcher environment, not on the VPS and never in Git.
# Use a DIFFERENT access policy token: logs:read, this one personal tenant only.
HOME_HUB_LOKI_URL=https://logs-prod-REPLACE.grafana.net
HOME_HUB_LOKI_TENANT=REPLACE
HOME_HUB_LOKI_READ_TOKEN=REPLACE_WITH_LOGS_READ_ONLY_ACCESS_POLICY_TOKEN
# Optional: absolute path in an existing/new owner-only (0700) directory.
# HOME_HUB_LOG_AUDIT_FILE=/home/your-user/.cache/home-hub/log-query-audit/queries.jsonl
