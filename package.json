{
  "name": "home-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "db:generate": "pnpm --filter @home-hub/database generate",
    "db:migrate": "pnpm --filter @home-hub/database migrate",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
